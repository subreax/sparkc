#src
float test(int a, float b) {
    return a + b;
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'test',
      returnType: 'float',
      params: [
        AstFunParam(
          type: 'int',
          name: 'a.0'
        ),
        AstFunParam(
          type: 'float',
          name: 'b.1'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'float',
              op: '+',
              left: AstCast(
                type: 'float',
                exp: AstVar(
                  type: 'int',
                  id: 'a.0'
                )
              ),
              right: AstVar(
                type: 'float',
                id: 'b.1'
              )
            )
          )
        ]
      )
    )
  ]
)