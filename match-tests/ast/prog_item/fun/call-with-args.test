#src
fun mul(a: int, b: int): int {
    return a * b;
}

fun main(): int {
    return mul(3, 5);
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'mul',
      returnType: 'int',
      params: [
        AstFunParam(
          type: 'int',
          name: 'a.0'
        ),
        AstFunParam(
          type: 'int',
          name: 'b.1'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'int',
              op: '*',
              left: AstVar(
                type: 'int',
                id: 'a.0'
              ),
              right: AstVar(
                type: 'int',
                id: 'b.1'
              )
            )
          )
        ]
      )
    ),
    AstFunction(
      name: 'main',
      returnType: 'int',
      params: [],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstFunCall(
              type: 'int',
              funName: 'mul',
              args: [
                AstConstantExp(
                  type: 'int',
                  value: '3'
                ),
                AstConstantExp(
                  type: 'int',
                  value: '5'
                )
              ]
            )
          )
        ]
      )
    )
  ]
)
