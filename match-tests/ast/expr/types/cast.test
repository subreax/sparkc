#src
int main(int a, float b) {
    return a + b;
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'main',
      returnType: 'int',
      params: [
        AstFunParam(
          type: 'int',
          name: 'a.0'
        ),
        AstFunParam(
          type: 'float',
          name: 'b.1'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstCast(
              type: 'int',
              exp: AstBinaryExp(
                type: 'float',
                op: '+',
                left: AstCast(
                  type: 'float',
                  exp: AstVar(
                    type: 'int',
                    id: 'a.0'
                  )
                ),
                right: AstVar(
                  type: 'float',
                  id: 'b.1'
                )
              )
            )
          )
        ]
      )
    )
  ]
)
