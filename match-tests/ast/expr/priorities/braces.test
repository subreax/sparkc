#src
fun main(): int {
    return (1 + 2) * 3;
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'main',
      returnType: 'int',
      params: [],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'int',
              op: '*',
              left: AstBinaryExp(
                type: 'int',
                op: '+',
                left: AstConstantExp(
                  type: 'int',
                  value: '1'
                ),
                right: AstConstantExp(
                  type: 'int',
                  value: '2'
                )
              ),
              right: AstConstantExp(
                type: 'int',
                value: '3'
              )
            )
          )
        ]
      )
    )
  ]
)
