#cli
--emit skr

#src
fun main(value: int): int {
    var res = 0;
    while (value) {
        res = res + value;
        value = value - 1;
    }
    return res;
}

#expect
fun main(value.0: int): int
    copy res.1 = int 0
    .start_1:
    jmp .end_2 if int value.0 == 0
    res.1 = int res.1 + value.0
    value.0 = int value.0 - 1
    jmp .start_1
    .end_2:
    copy retval.2 = int res.1
    jmp .ret_0
    .ret_0:
