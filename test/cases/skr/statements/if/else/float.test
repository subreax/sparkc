#cli
--emit skr

#src
fun min(a: float, b: float): float {
    var result = 0.0f;
    if (a > b) {
        result = b;
    }
    else {
        result = a;
    }
    return result;
}

#expect
fun min(a.0: float, b.1: float): float
    copy result.2 = float 0
    jmp .false_1 if float a.0 <= b.1
    copy result.2 = float b.1
    jmp .end_2
    .false_1:
    copy result.2 = float a.0
    .end_2:
    copy retval.3 = float result.2
    jmp .ret_0
    .ret_0:
