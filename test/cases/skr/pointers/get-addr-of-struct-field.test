#cli
--emit skr

#src
struct color(r: float, g: float, b: float);

fun main(): int {
    var c = color(1.0f, 0.5f, 0.0f);
    var pg = &c.g;
    return 0;
}

#expect
fun main(): int
    copy 0(c.0) = float 1
    copy 4(c.0) = float 0.5
    copy 8(c.0) = float 0
    pg.1 = addrOf(c.0)+4
    copy retval.2 = int 0
    jmp .ret_0
    .ret_0:
