#cli
--emit ast

#src
fun main(a: int, b: int, c: int): int {
    if (a && b || c) {
        return 1;
    }
    return 0;
}

#expect
AstFunction(
  name: 'main',
  returnType: 'int',
  params: [
    AstFunParam(
      type: 'int',
      name: 'a.0'
    ),
    AstFunParam(
      type: 'int',
      name: 'b.1'
    ),
    AstFunParam(
      type: 'int',
      name: 'c.2'
    )
  ],
  body: AstBlock(
    items: [
      AstIfStatement(
        cond: AstBinaryExp(
          type: 'int',
          op: 'or',
          left: AstBinaryExp(
            type: 'int',
            op: 'and',
            left: AstVar(
              type: 'int',
              id: 'a.0'
            ),
            right: AstVar(
              type: 'int',
              id: 'b.1'
            )
          ),
          right: AstVar(
            type: 'int',
            id: 'c.2'
          )
        ),
        true: AstCompoundStatement(
          block: AstBlock(
            items: [
              AstReturnStatement(
                exp: AstConstantExp(
                  type: 'int',
                  value: '1'
                )
              )
            ]
          )
        )
      ),
      AstReturnStatement(
        exp: AstConstantExp(
          type: 'int',
          value: '0'
        )
      )
    ]
  )
)
