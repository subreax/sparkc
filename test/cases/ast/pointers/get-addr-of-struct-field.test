#cli
--emit ast

#src
struct color(r: float, g: float, b: float);

fun main(): int {
    var c = color(1.0f, 0.5f, 0.0f);
    var pg = &c.g;
    return 0;
}

#expect
AstStruct(
  tag: 'color',
  fields: [
    Field(
      type: 'float',
      name: 'r'
    ),
    Field(
      type: 'float',
      name: 'g'
    ),
    Field(
      type: 'float',
      name: 'b'
    )
  ]
)
AstFunction(
  name: 'main',
  returnType: 'int',
  params: [],
  body: AstBlock(
    items: [
      AstVarDeclaration(
        type: 'color',
        name: 'c.0',
        init: AstStructInit(
          type: 'color',
          args: [
            AstConstantExp(
              type: 'float',
              value: '1'
            ),
            AstConstantExp(
              type: 'float',
              value: '0.5'
            ),
            AstConstantExp(
              type: 'float',
              value: '0'
            )
          ]
        )
      ),
      AstVarDeclaration(
        type: 'float*',
        name: 'pg.1',
        init: AstAddrOf(
          type: 'float*',
          exp: AstDot(
            type: 'float',
            from: AstVar(
              type: 'color',
              id: 'c.0'
            ),
            depth: 1,
            field: AstVar(
              type: 'float',
              id: 'g'
            )
          )
        )
      ),
      AstReturnStatement(
        exp: AstConstantExp(
          type: 'int',
          value: '0'
        )
      )
    ]
  )
)
