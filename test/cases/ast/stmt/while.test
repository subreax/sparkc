#cli
--emit ast

#src
fun fact(n: int): int {
    var result = 1;
    while (n > 1) {
        result = result * n;
        n = n - 1;
    }
    return result;
}

#expect
AstFunction(
  name: 'fact',
  returnType: 'int',
  params: [
    AstFunParam(
      type: 'int',
      name: 'n.0'
    )
  ],
  body: AstBlock(
    items: [
      AstVarDeclaration(
        type: 'int',
        name: 'result.1',
        init: AstConstantExp(
          type: 'int',
          value: '1'
        )
      ),
      AstWhileStatement(
        cond: AstBinaryExp(
          type: 'int',
          op: '>',
          left: AstVar(
            type: 'int',
            id: 'n.0'
          ),
          right: AstConstantExp(
            type: 'int',
            value: '1'
          )
        ),
        body: AstCompoundStatement(
          block: AstBlock(
            items: [
              AstExpressionStatement(
                exp: AstAssignment(
                  type: 'int',
                  var: AstVar(
                    type: 'int',
                    id: 'result.1'
                  ),
                  exp: AstBinaryExp(
                    type: 'int',
                    op: '*',
                    left: AstVar(
                      type: 'int',
                      id: 'result.1'
                    ),
                    right: AstVar(
                      type: 'int',
                      id: 'n.0'
                    )
                  )
                )
              ),
              AstExpressionStatement(
                exp: AstAssignment(
                  type: 'int',
                  var: AstVar(
                    type: 'int',
                    id: 'n.0'
                  ),
                  exp: AstBinaryExp(
                    type: 'int',
                    op: '-',
                    left: AstVar(
                      type: 'int',
                      id: 'n.0'
                    ),
                    right: AstConstantExp(
                      type: 'int',
                      value: '1'
                    )
                  )
                )
              )
            ]
          )
        )
      ),
      AstReturnStatement(
        exp: AstVar(
          type: 'int',
          id: 'result.1'
        )
      )
    ]
  )
)
