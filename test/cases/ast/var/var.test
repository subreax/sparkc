#cli
--emit ast

#src
fun main(): int {
    var a = 2;
    var b = 3;
    return a + b;
}

#expect
AstFunction(
  name: 'main',
  returnType: 'int',
  params: [],
  body: AstBlock(
    items: [
      AstVarDeclaration(
        type: 'int',
        name: 'a.0',
        init: AstConstantExp(
          type: 'int',
          value: '2'
        )
      ),
      AstVarDeclaration(
        type: 'int',
        name: 'b.1',
        init: AstConstantExp(
          type: 'int',
          value: '3'
        )
      ),
      AstReturnStatement(
        exp: AstBinaryExp(
          type: 'int',
          op: '+',
          left: AstVar(
            type: 'int',
            id: 'a.0'
          ),
          right: AstVar(
            type: 'int',
            id: 'b.1'
          )
        )
      )
    ]
  )
)
