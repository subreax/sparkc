#cli
--emit rva-initial


#src
struct color(r: float, g: float, b: float);
struct Root(trash: int, c: color);

fun main(arg: Root*): int {
    var c = color(1.0f, 0.5f, 0.0f);
    arg.c = c;
    return 0;
}


#expect
label          main:
prologue       prologue 0
move           pr(arg.0) = a0
move           pm(c.1+0) = 32768
move           pm(c.1+4) = 16384
move           pm(c.1+8) = 0
move           t6 = pr(arg.0)
move           [t6+4] = pm(c.1+0)
move           [t6+8] = pm(c.1+4)
move           [t6+12] = pm(c.1+8)
move           pr(retval.2) = 0
jump           jump to .ret_0
label          .ret_0:
move           a0 = pr(retval.2)
epilogue       epilogue 0
return         ret
