struct color(float r, float g, float b);

color pixel(float x, float t) {
    color c1 = color_temp(2500);
    color c2 = color_temp(1000);
    float t1 = t*0.25;
    color corr = color(1, 0.85, 0.8);
    return mul(mix(
        mix(c1, c2, norm(sin(t1))),
        mix(c1, c2, norm(cos(t1))),
        x
    ), corr);
}

float norm(float x) { return (x + 1) * 0.5; }
float sin(float a) { return a; }
float cos(float a) { return a; }
color color_temp(float t) { return color(1,1,1); }
color mix(color c1, color c2, float f) { return c1; }
color mul(color c1, color c2) { return c1; }
