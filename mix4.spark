struct color(float r, float g, float b, float a);

color pixel(float x) {
    return mul(
        mix(
            color(1.0, 0.5, 0.0, 1.0), 
            color(0.5, 0.1, 0.2, 1.0), 
            x
        ),
        x
    );
}

color mix(color c1, color c2, float val) {
    return color(
        lerp(c1.r, c2.r, val),
        lerp(c1.g, c2.g, val),
        lerp(c1.b, c2.b, val),
        lerp(c1.a, c2.a, val)
    );
}

float lerp(float a, float b, float val) {
    return a + (b - a) * val;
}

color mul(color c, float f) {
    return color(
        c.r * f,
        c.g * f,
        c.b * f,
        c.a * f
    );
}
