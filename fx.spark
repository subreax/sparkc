struct color(float r, float g, float b, float a);

color pixel(float x) {
    return mul(
        color(x, 0.5 * x, 0.0, 1.0),
        color(0.7, x, x, 1.0)
    );
}

float mulf(float a, float b) {
    return a * b;
}

color mul(color c1, color c2) {
    return color(
        c1.r * c2.r,
        c1.g * c2.g,
        c1.b * c2.b,
        c1.a * c2.a
    );
}
