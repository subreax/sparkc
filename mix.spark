struct color(float r, float g, float b, float a);

int pixel(color& out, float x) {
    color c1;
    c1.r = 1.0;
    c1.g = 0.0;
    c1.b = 0.0;
    c1.a = 1.0;

    color c2;
    c2.r = 0.0;
    c2.g = 1.0;
    c2.b = 0.0;
    c2.a = 1.0;

    mix(out, c1, c2, x);
    return 0;
}

int mix(color& out, color& c1, color& c2, float val) {
    out.r = lerp(c1.r, c2.r, val);
    out.g = lerp(c1.g, c2.g, val);
    out.b = lerp(c1.b, c2.b, val);
    out.a = lerp(c1.a, c2.a, val);
    return 0;
}

float lerp(float a, float b, float val) {
    return a + (b - a) * val;
}
