#src
fun main(n: int, skip: int): int {
    var i = 0;
    var sum = 0;
    while (i < n) {
        if (i != skip) {
            sum = sum + i;
        }
        i = i + 1;
    }
    return sum;
}

#expect
fun main(n.0: int, skip.1: int): int
    copy i.2 = int 0
    copy sum.3 = int 0
    .start_1:
    jmp .end_2 if int i.2 >= n.0
    jmp .false_3 if int i.2 == skip.1
    sum.3 = int sum.3 + i.2
    .false_3:
    i.2 = int i.2 + 1
    jmp .start_1
    .end_2:
    copy retval.4 = int sum.3
    jmp .ret_0
    .ret_0:
