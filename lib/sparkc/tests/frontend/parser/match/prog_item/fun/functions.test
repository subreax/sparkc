#src
fun fun1(a: int, b: int): int {
    return a + b;
}

fun fun2(a: int, b: int): int {
    return a * b;
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'fun1',
      returnType: 'int',
      params: [
        AstFunParam(
          type: 'int',
          name: 'a.0'
        ),
        AstFunParam(
          type: 'int',
          name: 'b.1'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'int',
              op: '+',
              left: AstVar(
                type: 'int',
                id: 'a.0'
              ),
              right: AstVar(
                type: 'int',
                id: 'b.1'
              )
            )
          )
        ]
      )
    ),
    AstFunction(
      name: 'fun2',
      returnType: 'int',
      params: [
        AstFunParam(
          type: 'int',
          name: 'a.2'
        ),
        AstFunParam(
          type: 'int',
          name: 'b.3'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'int',
              op: '*',
              left: AstVar(
                type: 'int',
                id: 'a.2'
              ),
              right: AstVar(
                type: 'int',
                id: 'b.3'
              )
            )
          )
        ]
      )
    )
  ]
)
