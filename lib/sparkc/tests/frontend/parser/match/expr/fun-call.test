#src
fun noise(a: float, b: float, c: int): float {
    return a + b * c;
}

fun main(): int {
    return noise(0.0f, 1.0f, 2);
}

#expect
AstProgram(
  items: [
    AstFunction(
      name: 'noise',
      returnType: 'float',
      params: [
        AstFunParam(
          type: 'float',
          name: 'a.0'
        ),
        AstFunParam(
          type: 'float',
          name: 'b.1'
        ),
        AstFunParam(
          type: 'int',
          name: 'c.2'
        )
      ],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstBinaryExp(
              type: 'float',
              op: '+',
              left: AstVar(
                type: 'float',
                id: 'a.0'
              ),
              right: AstBinaryExp(
                type: 'float',
                op: '*',
                left: AstVar(
                  type: 'float',
                  id: 'b.1'
                ),
                right: AstCast(
                  type: 'float',
                  exp: AstVar(
                    type: 'int',
                    id: 'c.2'
                  )
                )
              )
            )
          )
        ]
      )
    ),
    AstFunction(
      name: 'main',
      returnType: 'int',
      params: [],
      body: AstBlock(
        items: [
          AstReturnStatement(
            exp: AstCast(
              type: 'int',
              exp: AstFunCall(
                type: 'float',
                funName: 'noise',
                args: [
                  AstConstantExp(
                    type: 'float',
                    value: '0'
                  ),
                  AstConstantExp(
                    type: 'float',
                    value: '1'
                  ),
                  AstConstantExp(
                    type: 'int',
                    value: '2'
                  )
                ]
              )
            )
          )
        ]
      )
    )
  ]
)